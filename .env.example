APP_NAME=MyCFO+
APP_ENV=local
APP_URL=https://mycfoplus.com
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=finance_app
DB_PASSWORD=

# Session lifetime is currently fixed in code (session cookie, expires
# when the browser closes — see public/index.php) rather than
# configurable here. There's no separate idle-timeout enforcement yet.

# Used by bin/backup.sh (see docs/backup-and-recovery.md). Backups are
# refused unencrypted if this is blank — pick a strong, unique passphrase
# and store it somewhere other than this file (a password manager, not a
# copy of .env sitting next to the backups it protects).
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=30

# Read-only Master HQ API (GET /api/master-hq/v1/summary — see docs/api.md).
# MASTER_HQ_API_TOKEN: a long random secret (e.g. `openssl rand -hex 32`)
# Master HQ sends as "Authorization: Bearer <token>". Leaving this blank
# disables the endpoint entirely (every request gets 401) rather than
# leaving it open.
# MASTER_HQ_HOUSEHOLD_ID: which household's data this API reports on —
# this app supports multiple households, but the endpoint has no
# concept of "sign in as a household" the way a browser session does,
# so this must be set explicitly rather than guessed (e.g. "the first
# household").
MASTER_HQ_API_TOKEN=
MASTER_HQ_HOUSEHOLD_ID=

# Outbound email (App\Support\Mailer, SMTP via PHPMailer). Currently only
# used by bin/send-budget-reminders.php; password reset and household
# invitation links are still logged rather than emailed (see README).
# Leaving any of these blank disables sending — the link gets logged
# instead, same as before this existed.
#
# For Gmail/Google Workspace: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME is the full @gmail.com (or Workspace) address, and
# MAIL_PASSWORD is a 16-character App Password (Google Account -> Security
# -> 2-Step Verification -> App Passwords) — never the real account
# password, and this requires 2-Step Verification to be turned on first.
#
# MAIL_FROM_ADDRESS: Gmail's SMTP servers reject (or silently rewrite) a
# From address you don't actually control. On a personal Gmail account
# this generally has to be the same address as MAIL_USERNAME, unless
# you've added it as a verified "Send mail as" alias in Gmail's own
# settings first. On Google Workspace with your own domain, you can send
# as any address in that domain.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
