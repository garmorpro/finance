APP_NAME=Finance
APP_ENV=local
APP_URL=https://finance.morganserver.com
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=finance_app
DB_PASSWORD=

# Session lifetime is currently fixed in code (session cookie, expires
# when the browser closes — see public/index.php) rather than
# configurable here. There's no separate idle-timeout enforcement yet.

# Used by bin/backup.sh (see docs/backup-and-recovery.md). Backups are
# refused unencrypted if this is blank — pick a strong, unique passphrase
# and store it somewhere other than this file (a password manager, not a
# copy of .env sitting next to the backups it protects).
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=30

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
