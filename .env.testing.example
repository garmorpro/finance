APP_NAME=MyCFO+
APP_ENV=testing
APP_URL=http://localhost
APP_DEBUG=true

# A real (but test-only, not shared with production) key — AccountRepository/
# GoalRepository/RecurringItemRepository encrypt name/notes/description
# fields (App\Support\FieldCipher) on every create()/update(), so this
# has to be valid for those repositories' integration tests to run at
# all. Fine to commit a real value here, unlike .env.example's blank
# ENCRYPTION_KEY — this only ever protects disposable test data.
ENCRYPTION_KEY=JEIT3198x8QKtzl6DBq70HmgYR5P4sXBcPnT7U3rEoo=

# Point this at a DEDICATED test database, never at production. The test
# suite runs DDL (migrations) and DML against it, and the safety check in
# tests/DatabaseTestCase.php refuses to run unless DB_DATABASE contains
# "test" as a literal substring — pick a name like the one below so that
# check actually protects you.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_test
DB_USERNAME=finance_app
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
